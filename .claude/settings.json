{
  "isolatePeerMachines": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node oracles/hook-ouverture.mjs --contexte-json",
            "timeout": 240,
            "async": true
          },
          {
            "type": "command",
            "command": "node oracles/hook-produits-intacts.mjs --empreinte",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node oracles/hook-produits-intacts.mjs",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node oracles/oracle-secrets-hors-perimetre.mjs"
          },
          {
            "type": "command",
            "command": "node oracles/hook-restitution.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node oracles/hook-publication-hebergee.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node oracles/hook-identite-sortante.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node oracles/hook-remisage.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node oracles/hook-puits-windows.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/readme-dossiers.mjs --silencieux",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node scripts/generer-lisezmoi-output.mjs --silencieux",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node oracles/hook-ecriture.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node oracles/hook-lexique.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
