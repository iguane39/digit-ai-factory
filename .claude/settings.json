{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "node oracles/hook-ouverture.mjs", "timeout": 240 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node oracles/hook-restitution.mjs", "timeout": 60 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node scripts/readme-dossiers.mjs --silencieux", "timeout": 30 }
        ]
      }
    ]
  }
}
